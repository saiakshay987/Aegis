# ── LLM keys (fill in ONE — engine tries OpenAI first, Gemini second)
# If neither is set, the hardcoded fallback response is used (safe for demo)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── Service ports
# Main API (main.py):       uvicorn main:app --reload --port 8000
# Empathy Engine:           uvicorn empathy_engine:app --reload --port 8001
